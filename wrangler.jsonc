{
  // Slate on Cloudflare: the app's files, plus /api/summary (on-demand Claude summaries, written in the background)
  "name": "slate",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "workflows": [{ "name": "slate-summary", "binding": "SUMMARY", "class_name": "SummaryWorkflow" }],
  "triggers": { "crons": ["* * * * *", "*/2 * * * *"] },  // the second one is the morning email's own run
  "observability": { "enabled": true },
  // the worker's binding to itself: the morning email's timed run hands its work to a request (worker/index.js scheduled())
  "services": [{ "binding": "SELF", "service": "slate" }],
  // keep variables added in the Cloudflare dashboard when GitHub deploys (without this, plain-text ones are wiped)
  "keep_vars": true
}
